FROM node:18-alpine

WORKDIR /var/www

# Utilities for command injection testing
RUN apk add --no-cache iputils curl wget

COPY package.json .
RUN npm install

COPY app_standalone.js .

# Files for directory traversal testing
RUN echo "This is a readme file" > readme.txt && \
    echo "Sensitive config data" > config.txt && \
    mkdir -p /var/www/uploads

EXPOSE 3001

ENV PORT=3001

CMD ["node", "app_standalone.js"]
