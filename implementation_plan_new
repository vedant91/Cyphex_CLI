## Phase 2: Verification Gate (Day 2-4 — 10 hours)

This is the highest-ROI upgrade. Once this exists, CYPHEX **never accepts a patch that doesn't actually work**.

### 2.1 Post-patch exploit replay

#### [NEW] backend/patch/verifier.py

After applying a patch to the sandbox, replay the exact exploit that found the vuln:
```python
class PatchVerifier:
    async def verify_patch(self, vuln, sandbox_url):
        """Replay the exploit. If it still works, the patch failed."""
        
        # 1. Replay the exact exploit payload
        async with httpx.AsyncClient() as client:
            response = await client.request(
                method=vuln.method or "GET",
                url=f"{sandbox_url}{vuln.endpoint}",
                data=vuln.payload if vuln.method == "POST" else None,
                params={"q": vuln.payload} if vuln.method == "GET" else None,
            )
        
        still_vulnerable = self._check_exploit_success(vuln, response)
        
        # 2. Liveness check — endpoint still works for benign input
        benign_response = await client.get(f"{sandbox_url}{vuln.endpoint}")
        endpoint_alive = benign_response.status_code < 500
        
        # 3. Anti-suppression check
        patched_code = open(vuln.file_path).read()
        has_suppression = any(s in patched_code for s in [
            "nosemgrep", "eslint-disable", "# noqa", "// @ts-ignore"
        ])
        
        return {
            "vuln_fixed": not still_vulnerable,
            "endpoint_alive": endpoint_alive,
            "no_suppression": not has_suppression,
            "verdict": "PASS" if (not still_vulnerable and endpoint_alive and not has_suppression) else "FAIL"
        }
```

### 2.2 Rollback on verification failure

```python
async def apply_and_verify(self, patch, vuln, sandbox):
    # Backup original
    backup = open(vuln.file_path).read()
    
    # Apply patch
    self._apply_patch(vuln.file_path, patch)
    
    # Restart sandbox app
    await sandbox.restart()
    
    # Verify
    result = await self.verifier.verify_patch(vuln, sandbox.url)
    
    if result["verdict"] == "FAIL":
        # ROLLBACK
        open(vuln.file_path, "w").write(backup)
        await sandbox.restart()
        return {"status": "rolled_back", "reason": result}
    
    return {"status": "verified", "evidence": result}
```

