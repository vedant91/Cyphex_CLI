## Phase 3: Vector-less RAG + Code Context (Day 4-6 — 8 hours)

Now the model gets REAL code context. This is where patch quality jumps dramatically.

### 3.1 Sandbox code indexer (vector-less)

#### [NEW] backend/rag/code_indexer.py

Walk the sandbox, build keyword index. No embeddings, no vector DB:
```python
class CodeIndexer:
    """Vector-less code retrieval. Zero dependencies beyond stdlib."""
    
    SKIP_DIRS = {"node_modules", ".git", "dist", "build", "__pycache__", ".venv"}
    SKIP_EXTENSIONS = {".map", ".min.js", ".lock", ".png", ".jpg"}
    MAX_FILE_SIZE = 512 * 1024  # 512KB cap
    
    def __init__(self, sandbox_path):
        self.root = sandbox_path
        self.files = {}  # path → {content, metadata}
    
    def build_index(self):
        for root, dirs, files in os.walk(self.root):
            dirs[:] = [d for d in dirs if d not in self.SKIP_DIRS]
            for fname in files:
                if Path(fname).suffix in self.SKIP_EXTENSIONS:
                    continue
                fpath = os.path.join(root, fname)
                if os.path.getsize(fpath) > self.MAX_FILE_SIZE:
                    continue
                try:
                    content = open(fpath, encoding="utf-8", errors="ignore").read()
                except:
                    continue
                
                self.files[fpath] = {
                    "content": content,
                    "routes": re.findall(r'["\']/([\w/:]+)["\']', content),
                    "has_db": bool(re.search(r'db\.|query|SELECT|INSERT|sequelize|mongoose', content, re.I)),
                    "has_auth": bool(re.search(r'session|login|password|jwt|token|bcrypt', content, re.I)),
                    "imports": re.findall(r'require\(["\'](.+?)["\']\)|from ["\'](.+?)["\']', content),
                    "functions": re.findall(r'(?:function|const|let|var)\s+(\w+)\s*[=(]', content),
                }
    
    def find_for_vuln(self, vuln) -> list[dict]:
        """BM25-style keyword retrieval for a vulnerability."""
        endpoint = vuln.endpoint.strip("/").split("?")[0]
        results = []
        
        for path, meta in self.files.items():
            score = 0
            # Route match (strongest signal)
            if any(endpoint in r for r in meta["routes"]):
                score += 10
            # Vuln-type relevance
            if "sql" in vuln.name.lower() and meta["has_db"]:
                score += 5
            if "auth" in vuln.name.lower() and meta["has_auth"]:
                score += 5
            # Payload term match
            if vuln.payload and any(term in meta["content"] for term in vuln.payload.split()[:3]):
                score += 3
            
            if score > 0:
                results.append({"path": path, "score": score, **meta})
        
        return sorted(results, key=lambda x: -x["score"])[:3]
```

### 3.2 Function extractor (regex-based, no tree-sitter dep)

#### [NEW] backend/rag/function_extractor.py

Extract the enclosing function + imports for precise context:
```python
class FunctionExtractor:
    """Extract function context without tree-sitter dependency."""
    
    def extract_js_function(self, code, line_num):
        """Find the enclosing function/route handler for a line."""
        lines = code.split("\n")
        # Walk backwards to find function/route start
        start = line_num - 1
        brace_depth = 0
        while start > 0:
            if "{" in lines[start]: brace_depth += 1
            if "}" in lines[start]: brace_depth -= 1
            if brace_depth > 0 and re.match(
                r'\s*(router|app)\.(get|post|put|delete|patch|all)\s*\(|'
                r'\s*(async\s+)?function\s+\w+|'
                r'\s*(const|let|var)\s+\w+\s*=\s*(async\s+)?\(',
                lines[start]
            ):
                break
            start -= 1
        
        # Walk forward to find matching closing brace
        end = line_num
        brace_depth = 0
        while end < len(lines):
            brace_depth += lines[end].count("{") - lines[end].count("}")
            if brace_depth <= 0 and end > start:
                break
            end += 1
        
        return "\n".join(lines[start:end+1])
    
    def extract_imports(self, code):
        lines = code.split("\n")
        return "\n".join(l for l in lines[:50] if re.match(
            r'\s*(import |from |const \w+ = require|var \w+ = require)', l
        ))
```

