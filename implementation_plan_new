## Phase 4: Grounded Reasoning Layer (Day 6-8 — 6 hours)

Build the reasoning patterns directly (~150 LOC each), no Oracle dependency.

### 4.1 Grounded self-reflection (not vibes-based)

#### [NEW] backend/reasoning/reflexion.py

The critique comes from the VERIFIER, not the model's self-opinion:
```python
class GroundedReflexion:
    """Draft → Verify → Feed failure evidence → Improve. Max 3 rounds."""
    
    async def patch_with_reflexion(self, vuln, context, verifier, max_rounds=3):
        history = []
        
        for round in range(max_rounds):
            # Draft (or improve based on prior failure)
            if not history:
                patch = await self._generate_patch(vuln, context)
            else:
                patch = await self._improve_patch(vuln, context, history)
            
            # Verify with OBJECTIVE evidence
            result = await verifier.verify_patch(vuln, patch)
            
            if result["verdict"] == "PASS":
                return {"patch": patch, "rounds": round + 1, "status": "verified"}
            
            # Collect CONCRETE failure evidence (not model opinion)
            evidence = {
                "exploit_still_works": not result["vuln_fixed"],
                "endpoint_broken": not result["endpoint_alive"],
                "suppression_added": not result["no_suppression"],
            }
            history.append({"patch": patch, "failure": evidence})
        
        return {"patch": patch, "rounds": max_rounds, "status": "unverified"}
    
    async def _improve_patch(self, vuln, context, history):
        last_failure = history[-1]["failure"]
        feedback = f"""
Your previous patch FAILED verification:
- Exploit still works: {last_failure["exploit_still_works"]}
- Endpoint broken: {last_failure["endpoint_broken"]}
- Added suppression comment: {last_failure["suppression_added"]}

Previous attempt:
{history[-1]["patch"]}

Generate a DIFFERENT fix strategy. Do not repeat the same approach.
"""
        return await self._call_model(vuln, context, feedback)
```

### 4.2 Self-consistency (K candidates, verifier picks winner)

#### [NEW] backend/reasoning/self_consistency.py

```python
class SelfConsistency:
    """Generate K patches with different strategies. Keep the one that passes."""
    
    async def patch_with_consistency(self, vuln, context, verifier, k=3):
        strategies = self._get_strategies(vuln.cwe)  # From security KB
        candidates = []
        
        for i, strategy in enumerate(strategies[:k]):
            prompt = f"{context}\n\nFIX STRATEGY: {strategy['name']}\nPattern: {strategy['pattern']}"
            patch = await self._call_model(vuln, prompt, temperature=0.3 + (i * 0.1))
            
            result = await verifier.verify_patch(vuln, patch)
            candidates.append({
                "patch": patch,
                "strategy": strategy["name"],
                "verified": result["verdict"] == "PASS",
                "diff_size": len(patch),
            })
        
        # Pick verified candidate with smallest diff (least blast radius)
        verified = [c for c in candidates if c["verified"]]
        if verified:
            winner = min(verified, key=lambda c: c["diff_size"])
            return {"patch": winner["patch"], "status": "verified", 
                    "strategy": winner["strategy"]}
        
        # None passed — return best attempt marked unverified
        return {"patch": candidates[0]["patch"], "status": "unverified"}
```

