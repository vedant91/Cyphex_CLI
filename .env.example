# CYPHEX CLI — Environment Configuration
# Copy to .env and fill in values as needed.
# Only cloud keys are required if using cloud LLM mode.

# AI Backend Mode: 'local' (Ollama, default) | 'groq' (cloud)
# AI_BACKEND_MODE=local

# Ollama (local mode — no key needed, just install Ollama)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# Groq (cloud mode — free API key from https://console.groq.com)
# GROQ_API_KEY=

# Cerebras (legacy, currently broken)
# CEREBRAS_API_KEY=

# ── Cognee Agent Memory (100% local via Ollama) ──
# Required models: ollama pull llama3.1 && ollama pull nomic-embed-text
# Install: pip install -e .[memory]

LLM_PROVIDER=ollama
LLM_MODEL=ollama/llama3.1
LLM_ENDPOINT=http://localhost:11434

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=ollama/nomic-embed-text
EMBEDDING_ENDPOINT=http://localhost:11434
COGNEE_SKIP_CONNECTION_TEST=true
