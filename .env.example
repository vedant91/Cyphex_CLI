# CYPHEX CLI — Environment Configuration
# Copy to .env and fill in values as needed.
# Only cloud keys are required if using cloud LLM mode.

# AI Backend Mode: 'local' (Ollama, default) | 'groq' (cloud)
# AI_BACKEND_MODE=local

# Ollama (local mode — no key needed, just install Ollama)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# Groq (cloud mode — free API key from https://console.groq.com)
# GROQ_API_KEY=

# Cerebras (legacy, currently broken)
# CEREBRAS_API_KEY=

# ── Local API / daemon auth ──────────────────────────────────────
# Shared secret required on every request to the scan API (backend/backend/api.py)
# and the auto-heal daemon (cyphex/daemon.py). If unset, one is generated
# automatically on first run and persisted at ~/.cyphex/api_key — set this
# only if you want a fixed value (e.g. to share across machines).
# CYPHEX_API_KEY=

# Host/port/reload for the scan API server. Defaults to loopback-only.
# CYPHEX_API_HOST=127.0.0.1
# CYPHEX_API_PORT=8000
# CYPHEX_API_RELOAD=true

# Comma-separated list of origins allowed to call the scan API / daemon from
# a browser. Defaults to the Vite dev server.
# CYPHEX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── GitHub integration (cyphex/github_hook.py) ───────────────────
# Personal access token used to push auto-generated fix branches.
# GITHUB_TOKEN=

# Webhook signature secret — required for the webhook receiver to accept any
# request; requests are rejected if this isn't set.
# GITHUB_WEBHOOK_SECRET=

# Comma-separated allowlist of hosts the webhook is allowed to clone from /
# push an authenticated fix to. Defaults to github.com.
# CYPHEX_GIT_ALLOWED_HOSTS=github.com
